+// ---------------------------------------------------------------------------
+// Device-resident layout-descriptor cache (`ARC_DS_CACHE=1`).
+//
+// Every strided candle op uploads its own dims+strides array immediately before
+// the launch. Measured on V4 / H200 with nsys over 160 decode forwards: 762.9
+// `cuMemcpyHtoDAsync` per forward, 72 bytes and 2.77 us of HOST time each —
+// 2.11 ms of a 35.9 ms step, second only to the launches themselves.
+//
+// The payload is an immutable kernel INPUT, so every op sharing a layout can
+// read one device buffer. The cache key IS the byte image of the payload, which
+// makes a hit bit-identical to the upload it replaces *by construction* rather
+// than by argument.
+// ---------------------------------------------------------------------------
+type DsCache = Arc<Mutex<HashMap<(std::any::TypeId, Vec<u8>), Arc<dyn std::any::Any + Send + Sync>>>>;
+
+/// Bound on distinct layouts held. Past this the cache declines and the caller
+/// falls back to the per-op upload, so an unusual workload cannot grow it
+/// without limit.
+const DS_CACHE_MAX: usize = 1 << 16;
+
+static DS_CACHE_ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+static DS_HITS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static DS_MISSES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static DS_DECLINED: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn ds_cache_enabled() -> bool {
+    *DS_CACHE_ON.get_or_init(|| {
+        let on = matches!(std::env::var("ARC_DS_CACHE").as_deref(), Ok("1"));
+        eprintln!("[arc-ds-cache] policy enabled={on}");
+        on
+    })
+}
+
+/// Engagement accounting in BOTH directions, by count rather than first-fire:
+/// "no failures" is not "no results", and a green leg must prove work happened.
+fn ds_cache_tick() {
+    use std::sync::atomic::Ordering::Relaxed;
+    let h = DS_HITS.load(Relaxed);
+    let m = DS_MISSES.load(Relaxed);
+    let d = DS_DECLINED.load(Relaxed);
+    if (h + m + d) % 50_000 == 0 {
+        eprintln!("[arc-ds-cache] ENGAGED hits={h} misses={m} declined={d}");
+    }
+}
+
