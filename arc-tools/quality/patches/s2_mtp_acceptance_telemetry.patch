     /// Record acceptance counters from a verify result.
+    ///
+    /// With `ARC_MTP_LOG_ACCEPTANCE=1` set on the server process, the running
+    /// acceptance rate is logged (via [`Self::log_acceptance_rate`]) every
+    /// [`ACCEPTANCE_LOG_EVERY_PROPOSED`] proposed tokens, so a GPU session can
+    /// measure MTP acceptance from the serve log alone (`grep "MTP acceptance"`).
+    /// Off by default: the counters otherwise have no caller-facing sink.
     pub(crate) fn record_acceptance(&self, proposed: usize, accepted: usize) {
-        self.proposed_count
-            .fetch_add(proposed, std::sync::atomic::Ordering::Relaxed);
-        self.accepted_count
-            .fetch_add(accepted, std::sync::atomic::Ordering::Relaxed);
+        use std::sync::atomic::Ordering;
+        let total = self.proposed_count.fetch_add(proposed, Ordering::Relaxed) + proposed;
+        self.accepted_count.fetch_add(accepted, Ordering::Relaxed);
+        if acceptance_log_enabled()
+            && proposed > 0
+            && total / ACCEPTANCE_LOG_EVERY_PROPOSED
+                != (total - proposed) / ACCEPTANCE_LOG_EVERY_PROPOSED
+        {
+            self.log_acceptance_rate();
+        }
     }
