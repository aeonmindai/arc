+/// Log the running MTP acceptance rate once per this many proposed tokens
+/// (~every 32 decode steps at depth 2 — a line every handful of seconds at
+/// single-digit tok/s, without flooding the serve log).
+const ACCEPTANCE_LOG_EVERY_PROPOSED: usize = 64;
+
+/// `ARC_MTP_LOG_ACCEPTANCE=1` (or `true`) — env-gated MTP acceptance-rate
+/// telemetry in the serve log (RUN-161 GPU-session measurement).
+fn acceptance_log_enabled() -> bool {
+    use std::sync::OnceLock;
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        matches!(
+            std::env::var("ARC_MTP_LOG_ACCEPTANCE").as_deref(),
+            Ok("1") | Ok("true")
+        )
+    })
+}
